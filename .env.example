SQLITE_PATH="./data/dvl-lottery.db"
PORT=8787
NODE_ENV="development"

# Protect /admin once the app is public.
ADMIN_USERNAME="dvl"
ADMIN_PASSWORD=""

# Shopify custom app details. Do not commit real secrets.
SHOPIFY_SHOP="de-vlees-loterij.myshopify.com"
SHOPIFY_API_VERSION="2026-04"
SHOPIFY_ACCESS_TOKEN=""
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""
SHOPIFY_WEBHOOK_SECRET=""

# Public URL after tunneling/deploying, for example https://your-domain.com
PUBLIC_APP_URL=""

# DVL lottery rules
LOT_RULE_MODE="ORDER_MINIMUM"
LOT_ORDER_MINIMUM_CENTS=7000
LOT_PER_CENTS=7000
FREE_ENTRY_ENABLED=true
